# ===================================================
# QueueLess Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Supports MongoDB Atlas or local MongoDB)
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/queueless?retryWrites=true&w=majority
# For Local MongoDB: mongodb://localhost:27017/queueless
MONGODB_URI=mongodb://localhost:27017/queueless

# Session Security
# Provide a strong random secret key for session cookie encryption
SESSION_SECRET=queueless_super_secret_session_key_2026_change_in_prod

# Session Lifespan in milliseconds (default: 24 hours = 86400000 ms)
SESSION_MAX_AGE_MS=86400000

# Client Application URL (For CORS and redirect handling)
CLIENT_URL=http://localhost:5173
